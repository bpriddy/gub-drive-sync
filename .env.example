# gub-drive-sync — local/dev env. Copy to .env (gitignored).
#
# In Cloud Run these are injected from Secret Manager / env-vars by the
# cloudbuild deploy step; this file is only for `npm run dev`.

# ── Database ────────────────────────────────────────────────────────────────
# Shared GUB database (same instance gub-admin / GUB / gub-research-worker
# use). The Job reads + writes the drive_* tables and sync_runs.
DATABASE_URL=postgresql://user:pass@localhost:5432/gub_dev

# ── Bot-OAuth (Drive API auth) ──────────────────────────────────────────────
# The 'drive' bot's refresh token lives in bot_credentials. Building an
# OAuth2 client at sync time requires the client id + secret too. These
# are the SAME values gub-admin uses for the consent flow — set them via
# Secret Manager in Cloud Run; commit nothing here.
GUB_BOT_OAUTH_CLIENT_ID=
GUB_BOT_OAUTH_CLIENT_SECRET=

# ── Drive scan tuning ───────────────────────────────────────────────────────
# Root folder of the shared Drive that houses all account folders.
# Required for new-entity discovery; per-entity scans work without it.
DRIVE_ROOT_FOLDER_ID=

# Pacing between entities so a cold first run doesn't burn a day of
# Gemini quota in ten minutes.
DRIVE_DELAY_BETWEEN_ACCOUNTS_MS=5000
DRIVE_DELAY_BETWEEN_CAMPAIGNS_MS=2000

# Skip BINARY files (PDF/DOCX/PPTX/text) larger than this at extraction.
# 300 MB. Google-native files (Docs/Sheets/Slides) are API-traversed and
# bypass this cap — only the content-window cap (GEMINI_MAX_INPUT_CHARS)
# applies to them.
DRIVE_MAX_FILE_SIZE_BYTES=314572800

# Proposal TTL in days. Sweep-expired flips state=pending → expired past this.
DRIVE_PROPOSAL_TTL_DAYS=14

# ── Gemini ──────────────────────────────────────────────────────────────────
# When unset, the LLM driver falls back to a mock that returns schema-
# shaped empty responses — the pipeline still runs end-to-end in dev.
GEMINI_API_KEY=
GEMINI_MAX_INPUT_CHARS=40000

# ── Vision extraction (issue C1 / #34) ──────────────────────────────────────
# PDFs go through Gemini document understanding first, falling back to the
# text-layer parser (unpdf) on any gate or failure. Defaults shown; all
# optional. DRIVE_VISION_MODEL empty → the stack's default Gemini model.
DRIVE_VISION_ENABLED=true
DRIVE_VISION_MODEL=
# 14 MB raw — base64 inflates 4/3 and the API caps inline requests at 20 MB total.
DRIVE_VISION_MAX_FILE_SIZE_BYTES=14680064
DRIVE_VISION_MAX_PDF_PAGES=50
DRIVE_VISION_MAX_OUTPUT_TOKENS=32768
DRIVE_VISION_TIMEOUT_MS=180000

# ── Notify (reviewer emails) ────────────────────────────────────────────────
# Base URL of gub-review (public, no IAP). Notify embeds the magic-link as
# ${GUB_REVIEW_BASE_URL}/drive-review/${reviewToken}. Falls back to
# GUB_ADMIN_BASE_URL if unset (older deploys served the review route there).
GUB_REVIEW_BASE_URL=
GUB_ADMIN_BASE_URL=http://localhost:5173

# Mail driver. `console` (default) logs to stdout instead of dispatching.
MAIL_DRIVER=console
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=GUB

# ── Self-trigger (chunked-sync continuation) ────────────────────────────────
# The runner self-triggers a fresh Job execution at chunk boundaries via
# the Cloud Run Admin API. The runtime SA needs roles/run.developer on
# its own job — set by setup-gcp.sh after first deploy.
GCP_PROJECT_ID=os-test-491819
GCP_REGION=us-central1
DRIVE_SYNC_JOB_NAME=gub-drive-sync-dev

# ── Logger ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
