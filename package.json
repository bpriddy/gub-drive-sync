{
  "name": "gub-drive-sync",
  "version": "1.0.0",
  "description": "Cloud Run Job that runs the machine-driven Google Drive sync for GUB. Hosts the six modes — poll, run-full-sync, run-full-sync/continue, cron, notify, sweep-expired — that used to live as HTTP endpoints in gcp-universal-backend. Zero public surface; triggered only via the Cloud Run Admin API by Cloud Scheduler (poll) or gub-admin's Sync button (run-full-sync). The reviewer-facing /review endpoints remain in GUB.",
  "private": true,
  "main": "dist/src/main.js",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/src/main.js",
    "dev": "tsx -r dotenv/config src/main.ts",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "seed:status": "tsx -r dotenv/config scripts/seed-status-proposal.ts",
    "seed:new-entity": "tsx -r dotenv/config scripts/seed-new-entity-proposal.ts",
    "backfill": "tsx -r dotenv/config scripts/backfill.ts",
    "clear": "tsx -r dotenv/config scripts/clear.ts",
    "backfill-pending": "tsx -r dotenv/config src/main.ts backfill-pending",
    "probe-activity": "tsx -r dotenv/config scripts/probe-activity.ts",
    "probe-file-history": "tsx -r dotenv/config scripts/probe-file-history.ts",
    "probe-edited-files": "tsx -r dotenv/config scripts/probe-edited-files.ts",
    "probe-permission-test": "tsx -r dotenv/config scripts/probe-permission-test.ts",
    "probe-revision-content": "tsx -r dotenv/config scripts/probe-revision-content.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "dotenv": "^16.4.7",
    "google-auth-library": "^9.15.0",
    "googleapis": "^144.0.0",
    "mammoth": "^1.9.0",
    "officeparser": "^5.1.1",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "unpdf": "^1.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
